# Copy this file to .env for local development. Never commit the real .env file.
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-password
# Neon: open the project dashboard → Connect → Pooled connection and copy it.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_ENDPOINT-pooler.YOUR_REGION.aws.neon.tech/YOUR_DATABASE?sslmode=require
