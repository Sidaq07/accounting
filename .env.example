# Copy this file to .env for local development. Never commit the real .env file.
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-password
# Leave unset locally to use server/db/rajindera.db.
# DATABASE_PATH=/absolute/path/to/rajindera.db
